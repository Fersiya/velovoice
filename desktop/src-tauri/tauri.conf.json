{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeloVoice",
  "version": "0.2.0",
  "identifier": "app.velovoice.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VeloVoice",
        "width": 1240,
        "height": 780,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0e1015",
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}